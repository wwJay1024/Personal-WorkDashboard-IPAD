# iPad Dashboard 配置示例
#
# 用法：复制为 config.yaml 后按需修改
#   cp config.yaml.example config.yaml
#
# 全部字段都有默认值，缺省即可直接运行。

server:
  host: 0.0.0.0
  port: 9090
  data_dir: data
  static_dir: static
  dashboard_config_path: dashboard.json

# 定时休息提醒（到点后在看板上弹出提示）
reminder:
  enabled: true
  times:
    - "10:00"
    - "11:00"
    - "15:00"
    - "16:30"
  weekdays_only: true
  message: 该休息一下了
  break_duration_seconds: 300
